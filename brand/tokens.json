{
    "$description": "zerolith brand tokens, Slab on Basalt, in the Design Tokens Community Group format. tokens.css carries the same values as custom properties.",
    "color": {
        "basalt": {
            "$type": "color",
            "50": {
                "$value": "#F5F6F8"
            },
            "100": {
                "$value": "#E8EAED"
            },
            "200": {
                "$value": "#D5DAE0"
            },
            "300": {
                "$value": "#C9CED4"
            },
            "400": {
                "$value": "#9AA3AD"
            },
            "500": {
                "$value": "#737C88"
            },
            "600": {
                "$value": "#4F5864"
            },
            "800": {
                "$value": "#2A2F37"
            },
            "900": {
                "$value": "#171A1F"
            },
            "950": {
                "$value": "#0F1114"
            }
        },
        "lichen": {
            "$type": "color",
            "200": {
                "$value": "#C8E679"
            },
            "300": {
                "$value": "#AACF16",
                "$description": "The brand chartreuse. Spent only on the mark, the primary action, the active nav item, code keywords, and focus."
            },
            "700": {
                "$value": "#4B5E00",
                "$description": "Takes chartreuse's text and focus role on light grounds."
            }
        }
    },
    "theme": {
        "dark": {
            "$type": "color",
            "bg": {
                "$value": "{color.basalt.950}"
            },
            "surface": {
                "$value": "{color.basalt.900}"
            },
            "line": {
                "$value": "{color.basalt.800}"
            },
            "control-line": {
                "$value": "{color.basalt.500}"
            },
            "text": {
                "$value": "{color.basalt.100}"
            },
            "text-muted": {
                "$value": "{color.basalt.400}"
            },
            "accent": {
                "$value": "{color.lichen.300}"
            },
            "on-accent": {
                "$value": "{color.basalt.950}"
            },
            "accent-text": {
                "$value": "{color.lichen.300}"
            },
            "focus": {
                "$value": "{color.lichen.300}"
            },
            "danger": {
                "$value": "#FF7B72"
            },
            "warning": {
                "$value": "#E8C547"
            },
            "hint": {
                "$value": "#7CB3FF"
            },
            "success": {
                "$value": "{color.basalt.100}",
                "$description": "Success is the text color plus the check icon; chartreuse is not spent on status."
            }
        },
        "light": {
            "$type": "color",
            "bg": {
                "$value": "{color.basalt.50}"
            },
            "surface": {
                "$value": "#FFFFFF"
            },
            "line": {
                "$value": "{color.basalt.200}"
            },
            "control-line": {
                "$value": "{color.basalt.500}"
            },
            "text": {
                "$value": "{color.basalt.950}"
            },
            "text-muted": {
                "$value": "{color.basalt.600}"
            },
            "accent": {
                "$value": "{color.lichen.300}"
            },
            "on-accent": {
                "$value": "{color.basalt.950}"
            },
            "accent-text": {
                "$value": "{color.lichen.700}"
            },
            "focus": {
                "$value": "{color.lichen.700}"
            },
            "danger": {
                "$value": "#C42B2B"
            },
            "warning": {
                "$value": "#7A5B00"
            },
            "hint": {
                "$value": "#1F5BB8"
            },
            "success": {
                "$value": "{color.basalt.950}",
                "$description": "Success is the text color plus the check icon."
            }
        },
        "code": {
            "$type": "color",
            "$description": "Code blocks stay on basalt in both themes.",
            "bg": {
                "$value": "{color.basalt.950}"
            },
            "text": {
                "$value": "{color.basalt.100}"
            },
            "keyword": {
                "$value": "{color.lichen.300}"
            },
            "string": {
                "$value": "{color.basalt.300}"
            },
            "comment": {
                "$value": "{color.basalt.400}"
            }
        }
    },
    "font": {
        "$type": "fontFamily",
        "display": {
            "$value": [
                "Unbounded",
                "system-ui",
                "sans-serif"
            ],
            "$description": "Wordmark and headings, weight 600, tracking -0.03em, always lowercase in the wordmark."
        },
        "text": {
            "$value": [
                "Onest",
                "system-ui",
                "sans-serif"
            ]
        },
        "mono": {
            "$value": [
                "Martian Mono",
                "ui-monospace",
                "monospace"
            ],
            "$description": "Code, and uppercase labels at small sizes."
        }
    },
    "dimension": {
        "$type": "dimension",
        "rule": {
            "$value": "2px",
            "$description": "Every rule, border, and outline."
        },
        "radius": {
            "$value": "0px",
            "$description": "Square corners everywhere except app icon tiles."
        }
    },
    "terminal": {
        "$description": "Command line colors. Respect NO_COLOR and non-TTY output. Severities use the basic ANSI colors so each terminal theme tunes them to its own background; chartreuse appears only as a badge background with basalt text, which reads on light and dark terminals alike.",
        "badge": {
            "background": "#AACF16",
            "background-256": 148,
            "foreground": "#0F1114",
            "foreground-256": 233
        },
        "success": {
            "ansi": "green",
            "sgr": 32
        },
        "error": {
            "ansi": "red",
            "sgr": 31
        },
        "warning": {
            "ansi": "yellow",
            "sgr": 33
        },
        "hint": {
            "ansi": "blue",
            "sgr": 34
        },
        "muted": {
            "ansi": "bright black",
            "sgr": 90
        }
    }
}
