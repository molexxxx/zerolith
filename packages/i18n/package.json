{
    "name": "@zerolith/i18n",
    "version": "0.1.0-alpha.4",
    "description": "Internationalization for zerolith built on Intl with nothing shipped: locale negotiation and state, direction and document language, cached formatters, and a compiler that turns MessageFormat 2 catalogs into per-locale modules",
    "license": "Apache-2.0",
    "author": "molexxxx",
    "homepage": "https://github.com/molexxxx/zerolith#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/molexxxx/zerolith.git",
        "directory": "packages/i18n"
    },
    "bugs": {
        "url": "https://github.com/molexxxx/zerolith/issues"
    },
    "keywords": [
        "zerolith",
        "i18n",
        "intl",
        "messageformat"
    ],
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=24.0.0"
    },
    "bin": {
        "zerolith-i18n": "dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./compile": {
            "types": "./dist/compile.d.ts",
            "default": "./dist/compile.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json"
    },
    "peerDependencies": {
        "zerolith": "^0.1.0-alpha.4"
    },
    "devDependencies": {
        "zerolith": "^0.1.0-alpha.4"
    }
}
