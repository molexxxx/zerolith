{
    "name": "@zerolith/a11y",
    "version": "0.1.0-alpha.1",
    "description": "Accessibility primitives for zerolith: focus trap, roving tabindex, live announcer, focus origin, visually hidden styles, and media query signals, the pieces every component library rebuilds",
    "license": "Apache-2.0",
    "author": "molexxxx",
    "homepage": "https://github.com/molexxxx/zerolith#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/molexxxx/zerolith.git",
        "directory": "packages/a11y"
    },
    "bugs": {
        "url": "https://github.com/molexxxx/zerolith/issues"
    },
    "keywords": [
        "zerolith",
        "accessibility",
        "a11y",
        "focus-trap",
        "roving-tabindex"
    ],
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=24.0.0"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json"
    },
    "peerDependencies": {
        "zerolith": "^0.1.0-alpha.1"
    },
    "devDependencies": {
        "zerolith": "^0.1.0-alpha.1"
    }
}
