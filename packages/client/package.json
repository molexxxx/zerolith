{
    "name": "@zerolith/client",
    "version": "0.1.0-alpha.9",
    "description": "A typed HTTP client for zerolith over a neutral contract: generate the route table and types from an OpenAPI document, call operations with checked inputs, and read failures as RFC 9457 problems",
    "license": "Apache-2.0",
    "author": "molexxxx",
    "homepage": "https://zerolith.dev/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/molexxxx/zerolith.git",
        "directory": "packages/client"
    },
    "bugs": {
        "url": "https://github.com/molexxxx/zerolith/issues"
    },
    "keywords": [
        "zerolith",
        "openapi",
        "typed-client",
        "problem-details"
    ],
    "type": "module",
    "sideEffects": false,
    "engines": {
        "node": ">=24.0.0"
    },
    "bin": {
        "zerolith-client": "dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "development": "./dist/index.js",
            "default": "./dist/production/index.js"
        },
        "./generate": {
            "types": "./dist/generate.d.ts",
            "development": "./dist/generate.js",
            "default": "./dist/production/generate.js"
        },
        "./port": {
            "types": "./dist/port.d.ts",
            "development": "./dist/port.js",
            "default": "./dist/production/port.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "src",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node ../../scripts/production.ts"
    },
    "peerDependencies": {
        "zerolith": "^0.1.0-alpha.9"
    },
    "devDependencies": {
        "zerolith": "^0.1.0-alpha.9"
    }
}
