{
    "name": "zerolith-monorepo",
    "version": "0.1.0-alpha.1",
    "private": true,
    "description": "Monorepo for zerolith, a standalone frontend framework",
    "license": "Apache-2.0",
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "workspaces": [
        "packages/zerolith",
        "packages/router",
        "packages/devtools",
        "packages/vite",
        "packages/forms",
        "packages/client",
        "packages/test",
        "packages/a11y",
        "packages/i18n",
        "packages/otel"
    ],
    "scripts": {
        "build": "npm run build --workspaces --if-present",
        "typecheck": "tsc -p tsconfig.json",
        "lint": "oxlint",
        "test": "vitest run --project node",
        "test:browser": "vitest run --project browser",
        "test:all": "vitest run",
        "size": "node scripts/size.ts",
        "bench": "node benchmarks/run.ts",
        "serve": "node scripts/serve.ts",
        "docs": "node --conditions=development scripts/docs/build.ts",
        "docs:serve": "node scripts/serve.ts 8081 site",
        "brand": "node scripts/brand/render.ts",
        "check": "npm run build && npm run typecheck && npm run lint && npm run test:all && npm run size && npm run docs",
        "sbom": "npm sbom --sbom-format cyclonedx --omit dev"
    },
    "devDependencies": {
        "@opentelemetry/api": "1.9.1",
        "@opentelemetry/context-async-hooks": "2.12.0",
        "@opentelemetry/sdk-trace-base": "2.12.0",
        "@types/node": "26.6.6",
        "@vitest/browser-playwright": "5.0.5",
        "deno": "2.9.6",
        "marked": "18.1.2",
        "oxlint": "1.90.0",
        "playwright": "1.64.1",
        "rolldown": "1.2.15",
        "typescript": "7.0.2",
        "vite": "8.3.5",
        "vitest": "5.0.5"
    }
}
