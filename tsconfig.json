{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "jsx": "react-jsx",
        "jsxImportSource": "zerolith",
        "isolatedDeclarations": false,
        "allowImportingTsExtensions": true,
        "allowJs": true,
        "checkJs": true,
        "types": ["node"],
        "paths": {
            "zerolith": ["./packages/zerolith/src/index.ts"],
            "zerolith/ssr": ["./packages/zerolith/src/ssr.ts"],
            "zerolith/element": ["./packages/zerolith/src/element.ts"],
            "zerolith/jsx-runtime": ["./packages/zerolith/src/jsx-runtime.ts"],
            "zerolith/jsx-dev-runtime": ["./packages/zerolith/src/jsx-runtime.ts"],
            "@zerolith/router": ["./packages/router/src/index.ts"],
            "@zerolith/router/server": ["./packages/router/src/server.ts"],
            "@zerolith/devtools": ["./packages/devtools/src/index.ts"],
            "@zerolith/vite": ["./packages/vite/src/index.ts"],
            "@zerolith/vite/runtime": ["./packages/vite/src/runtime.ts"],
            "@zerolith/forms": ["./packages/forms/src/index.ts"],
            "@zerolith/client": ["./packages/client/src/index.ts"],
            "@zerolith/client/generate": ["./packages/client/src/generate.ts"],
            "@zerolith/client/port": ["./packages/client/src/port.ts"],
            "@zerolith/test": ["./packages/test/src/index.ts"],
            "@zerolith/a11y": ["./packages/a11y/src/index.ts"],
            "@zerolith/i18n": ["./packages/i18n/src/index.ts"],
            "@zerolith/i18n/compile": ["./packages/i18n/src/compile.ts"],
            "@zerolith/otel": ["./packages/otel/src/index.ts"]
        }
    },
    "include": [
        "packages/*/src",
        "packages/*/test",
        "packages/*/scripts",
        "scripts",
        "scripts/docs",
        "benchmarks/*.ts",
        "examples/*/*.js",
        "examples/*/*.ts",
        "examples/*/src",
        "examples/*/test",
        "vitest.config.ts"
    ],
    "exclude": [
        "**/node_modules",
        "**/dist",
        "packages/vite/test/fixture-prepare"
    ]
}
