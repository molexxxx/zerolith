{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "isolatedDeclarations": false,
        "types": ["node"]
    },
    "include": [
        "packages/*/src",
        "packages/*/test",
        "packages/*/scripts",
        "scripts",
        "vitest.config.ts"
    ],
    "exclude": [
        "**/node_modules",
        "**/dist"
    ]
}
