{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "noEmit": true,
        "isolatedDeclarations": false,
        "allowJs": true,
        "checkJs": true,
        "types": ["node"],
        "paths": {
            "zerolith": ["./packages/zerolith/src/index.ts"],
            "@zerolith/router": ["./packages/router/src/index.ts"]
        }
    },
    "include": [
        "packages/*/src",
        "packages/*/test",
        "packages/*/scripts",
        "scripts",
        "benchmarks/*.ts",
        "examples/*/*.js",
        "examples/*/test",
        "vitest.config.ts"
    ],
    "exclude": [
        "**/node_modules",
        "**/dist"
    ]
}
